{
  "name": "focusKube-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the K8 Explorer web app (Kubernetes + Helm + Azure).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\"",
    "dev": "npm run clean && tsc -p tsconfig.json && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "build:bundle": "tsc -p tsconfig.json --noEmit && node ./scripts/build-esbuild.mjs",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --experimental-test-module-mocks --test-force-exit --test src/**/*.test.ts",
    "test:watch": "tsx --experimental-test-module-mocks --test-force-exit --test --watch src/**/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov --exclude \"src/**/*.test.ts\" --exclude \"src/testUtils/**\" npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.600.0",
    "@aws-sdk/client-eks": "^3.600.0",
    "@aws-sdk/client-sts": "^3.600.0",
    "@aws-sdk/credential-providers": "^3.600.0",
    "@kubernetes/client-node": "^0.22.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.13",
    "c8": "^12.0.0",
    "esbuild": "^0.25.12",
    "globals": "^16.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.41.0",
    "undici-types": "^6.20.0"
  }
}
