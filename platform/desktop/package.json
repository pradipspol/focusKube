{
  "name": "focusKube",
  "author": "TechAvise", 
  "description": "Kubernetes Cluster Explorer & Operations Console",
  "version": "0.1.1-1",
  "private": true,
  "homepage": "https://github.com/pradipspol/focusKube",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "node ./package.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "get-port": "^5.1.1"
  },
  "build": {
    "appId": "com.focusKube.desktop",
    "productName": "FocusKube",
    "electronVersion": "39.8.10",
    "npmRebuild": false,
    "afterPack": "./afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "assets/icons/app512.png",
      "assets/icons/app512.ico",
      "package.json",
      "node_modules/"
    ],
    "extraResources": [
      {
        "from": "extra",
        "to": "extras",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/icons/app512.ico",
      "target": ["nsis", "msi"],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "publisherName": "TechAvise"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "assets/icons/app512.ico",
      "uninstallerIcon": "assets/icons/app512.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer/nsis-installer-hook.nsh"
    },
    "msi": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "mac": {
      "icon": "assets/icons/app512.png",
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "identity": null
    },
    "linux": {
      "icon": "assets/icons/app512.png",
      "category": "Development",
      "target": ["AppImage", "deb"],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "maintainer": "TechAvise"
    }
  },
  "devDependencies": {
    "electron": "39.8.10",
    "7zip-bin": "^5.2.0",
    "electron-wix-msi": "^5.1.3",
    "electron-builder": "^24.0.0"
  }
}
