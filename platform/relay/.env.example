# Server
PORT=4001
RELAY_PUBLIC_URL=http://localhost:4001
NODE_ENV=development

# The real Anthropic API key — the only place in the whole system this should ever live.
ANTHROPIC_API_KEY=

# SQLite file (created automatically). Override for a persistent volume in production.
RELAY_DB_PATH=./data/relay.db

# Sessions
SESSION_COOKIE_NAME=fk_session
SESSION_TTL_DAYS=30

# OTP (email/SMS sign-in codes)
OTP_PEPPER=change-me-in-production
OTP_TTL_MINUTES=10

# Password reset
PASSWORD_RESET_TTL_MINUTES=30

# Dev-only seeded license key (used only when the licenses table is empty)
AI_RELAY_DEV_LICENSE_KEY=fk_dev_local_testing

# Google OAuth (sign-in with Google) — create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/v1/auth/google/callback

# Email delivery (password reset + email OTP). Any SMTP provider works. Leave unset in dev —
# emails/codes are logged to the console instead of sent.
SMTP_URL=
EMAIL_FROM=focusKube <no-reply@focuskube.dev>

# SMS delivery (mobile OTP), via Twilio. Leave unset in dev — codes are logged to the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
