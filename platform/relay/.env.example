# Required for production
# MongoDB Atlas connection. The relay cannot start without this.
MONGODB_URI=
# Replace with a unique, randomly generated secret before deploying.
OTP_PEPPER=change-me-in-production

# Required for selected features/providers
# Set to the public HTTPS origin when deploying the relay.
RELAY_PUBLIC_URL=http://localhost:4001
# AI chat requires credentials for the selected provider. See the AI section below.
AI_PROVIDER=anthropic

# Optional settings (defaults shown)
PORT=4001
NODE_ENV=development
MONGODB_DB_NAME=focuskube_relay
SESSION_COOKIE_NAME=fk_session
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30
AI_RELAY_DEV_LICENSE_KEY=fk_dev_local_testing
GITHUB_REPO=pradipspol/focusKube
ALLOWED_APP_REDIRECTS=
LOG_LEVEL=debug
FOCUSKUBE_LOG_FILE=logs/relay.jsonl

# AI provider credentials (set the credentials for the selected AI_PROVIDER)
# Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required when AI_PROVIDER=azure-openai.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Optional: enables the Kubernetes documentation search tool. Uses Azure OpenAI embeddings
# even when AI_PROVIDER=anthropic; requires the Azure key and endpoint above.
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# Optional: enables Google sign-in when both credentials are provided.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/v1/auth/google/callback

# Preferred email delivery: Brevo transactional email API. When set, this takes precedence
# over SMTP. Create an API key in Brevo; verify the sender configured by EMAIL_FROM.
BREVO_API_KEY=

# Secondary email delivery via SMTP. Used only when BREVO_API_KEY is blank. Without either
# provider configured, email delivery is skipped. Host-based settings take precedence over
# SMTP_URL. For Brevo SMTP, use smtp-relay.brevo.com:587 with SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Backward-compatible URL option; use this only when SMTP_HOST is blank.
SMTP_URL=
EMAIL_FROM=focusKube <no-reply@focuskube.dev>

# SMS OTP is disabled by default. Set true to expose and accept the existing SMS flow.
SMS_OTP_ENABLED=false
# Optional; required only when SMS_OTP_ENABLED=true. SMS implementation remains available.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Billing provider and Razorpay credentials. Razorpay keys and webhook secret are required
# when billing is enabled with this provider; the webhook secret is separate from the API
# key secret. Create them in the Razorpay dashboard.
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional subscription cycle counts (defaults shown).
RAZORPAY_TOTAL_COUNT_MONTHLY=1200
RAZORPAY_TOTAL_COUNT_YEARLY=100

# Optional pricing and organization defaults.
PRO_PRICE_MONTHLY_CENTS=1999
PRO_ANNUAL_DISCOUNT_PERCENT=10
PRO_PLAN_QUOTA=2000
USD_TO_INR_RATE=100
ORG_MIN_SEATS=2
ORG_MAX_SEATS=100
ORG_POOL_QUOTA_PER_SEAT=2000
ORG_INVITE_TTL_DAYS=14
ORG_MAX_INVITES_PER_HOUR=20
