{
  "name": "k8-explorer",
  "author": "TechAvise", 
  "description": "Kubernetes Explorer Desktop Client",
  "version": "0.1.0-1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "node ./package.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "get-port": "^5.1.1"
  },
  "build": {
    "appId": "com.k8-explorer.desktop",
    "productName": "k8-explorer",
    "electronVersion": "39.8.10",
    "npmRebuild": false,
    "afterPack": "./afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "assets/icons/app_150.png",
      "assets/icons/app512.ico",
      "package.json",
      "node_modules/"
    ],
    "extraResources": [
      {
        "from": "extra",
        "to": "extras",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/icons/app512.ico",
      "target": ["nsis", "msi"],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "assets/icons/app512.ico",
      "uninstallerIcon": "assets/icons/app512.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/nsis-installer-hook.nsh"
    },
    "msi": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "mac": {
      "icon": "assets/icons/app512.png",
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "icon": "assets/icons/app512.png",
      "category": "Development",
      "target": ["AppImage", "deb"],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "39.8.10",
    "7zip-bin": "^5.2.0",
    "electron-wix-msi": "^3.0.0",
    "electron-builder": "^24.0.0"
  }
}
