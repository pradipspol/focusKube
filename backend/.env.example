# Server
PORT=4000
HOST=0.0.0.0

# CORS origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173

SESSION_TTL_HOURS=168

# Optional: path to a kubeconfig file. Defaults to in-cluster config when running
# inside a pod, otherwise ~/.kube/config.
# KUBECONFIG=

# Set to "true" to allow viewing secret values decoded. Defaults to false.
ALLOW_SECRET_REVEAL=true

# Base URL of the frontend app.
APP_BASE_URL=http://localhost:5173
# Default local identity used for the desktop session when no email header is sent.
DEFAULT_ADMIN_EMAIL=prapol@ptc.com
