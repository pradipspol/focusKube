  "backend": {
    "framework": "Express.js",
    "language": "TypeScript",
    "apiBasePath": "/api/minikube",
    "endpoints": [
      {
        "method": "GET",
        "path": "/health",
        "description": "Check if Minikube installed",
        "query": [],
        "response": { "installed": "boolean" },
        "serviceMethod": "isMinikubeInstalled()"
      },
      {
        "method": "GET",
        "path": "/status",
        "description": "Get cluster status",
        "query": [
          { "name": "clusterName", "type": "string", "default": "minikube" }
        ],
        "response": "MinikubeCluster",
        "serviceMethod": "getStatus(clusterName)"
      },
      {
        "method": "POST",
        "path": "/start",
        "description": "Start cluster",
        "body": {
          "name": "string (optional)",
          "driver": "string (optional)",
          "cpus": "number (optional)",
          "memory": "string (optional)",
          "kubernetesVersion": "string (optional)"
        },
        "response": "MinikubeCluster",
        "serviceMethod": "startCluster(options)"
      },
      {
        "method": "POST",
        "path": "/stop",
        "description": "Stop cluster",
        "body": { "clusterName": "string" },
        "response": "MinikubeCluster",
        "serviceMethod": "stopCluster(clusterName)"
      },
      {
        "method": "POST",
        "path": "/delete",
        "description": "Delete cluster",
        "body": { "clusterName": "string" },
        "response": { "success": "boolean", "message": "string" },
        "serviceMethod": "deleteCluster(clusterName)"
      },
      {
        "method": "POST",
        "path": "/deploy",
        "description": "Deploy manifest",
        "body": {
          "manifest": "string (required)",
          "clusterName": "string (optional, default: 'minikube')"
        },
        "response": { "success": "boolean", "output": "string" },
        "serviceMethod": "deployManifest(manifest, clusterName)"
      },
      {
        "method": "GET",
        "path": "/deployments",
        "description": "List deployments",
        "query": [
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "response": { "deployments": ["DeploymentInfo[]"] },
        "serviceMethod": "getDeployments(clusterName, namespace)"
      },
      {
        "method": "GET",
        "path": "/pods",
        "description": "List pods",
        "query": [
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "response": { "pods": ["PodInfo[]"] },
        "serviceMethod": "getPods(clusterName, namespace)"
      },
      {
        "method": "GET",
        "path": "/pods/:podName/logs",
        "description": "Get pod logs",
        "params": { "podName": "string (required)" },
        "query": [
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "response": { "logs": "string" },
        "serviceMethod": "getPodLogs(podName, clusterName, namespace)"
      },
      {
        "method": "POST",
        "path": "/pods/:podName/exec",
        "description": "Execute command in pod",
        "params": { "podName": "string (required)" },
        "query": [
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "body": { "command": "string[] (required)" },
        "response": { "output": "string" },
        "serviceMethod": "execInPod(podName, command, clusterName, namespace)"
      },
      {
        "method": "POST",
        "path": "/pods/:podName/test",
        "description": "Test pod connectivity",
        "params": { "podName": "string (required)" },
        "query": [
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "response": {
          "name": "string",
          "status": "string",
          "readiness": "boolean",
          "logs": "string"
        },
        "serviceMethod": "testPod(podName, clusterName, namespace)"
      },
      {
        "method": "GET",
        "path": "/namespaces",
        "description": "Get available namespaces",
        "query": [
          { "name": "clusterName", "type": "string", "default": "minikube" }
        ],
        "response": { "namespaces": "string[]" },
        "serviceMethod": "getNamespaces(clusterName)"
      }
    ],
    "serviceMethods": [
      {
        "category": "Cluster Management",
        "methods": [
          {
            "name": "startCluster(options)",
            "returns": "Promise<MinikubeCluster>",
            "params": [
              { "name": "options", "type": "object", "optional": true }
            ],
            "description": "Start a new Minikube cluster with configuration"
          },
          {
            "name": "stopCluster(clusterName)",
            "returns": "Promise<MinikubeCluster>",
            "params": [
              { "name": "clusterName", "type": "string", "default": "minikube" }
            ],
            "description": "Stop a running cluster"
          },
          {
            "name": "deleteCluster(clusterName)",
            "returns": "Promise<{ success: boolean; message: string }>",
            "params": [
              { "name": "clusterName", "type": "string", "default": "minikube" }
            ],
            "description": "Delete a cluster"
          },
          {
            "name": "getStatus(clusterName)",
            "returns": "Promise<MinikubeCluster>",
            "params": [
              { "name": "clusterName", "type": "string", "default": "minikube" }
            ],
            "description": "Get current cluster status"
          },
          {
            "name": "isMinikubeInstalled()",
            "returns": "Promise<boolean>",
            "description": "Check if Minikube is installed"
          }
        ]
      },
      {
        "category": "Workload Management",
        "methods": [
          {
            "name": "deployManifest(manifest, clusterName)",
            "returns": "Promise<{ success: boolean; output: string }>",
            "params": [
              { "name": "manifest", "type": "string" },
              { "name": "clusterName", "type": "string", "default": "minikube" }
            ],
            "description": "Deploy Kubernetes manifest to cluster"
          },
          {
            "name": "getDeployments(clusterName, namespace)",
            "returns": "Promise<DeploymentInfo[]>",
            "params": [
              { "name": "clusterName", "type": "string", "default": "minikube" },
              { "name": "namespace", "type": "string", "default": "default" }
            ],
            "description": "List deployments in namespace"
          },
          {
            "name": "getPods(clusterName, namespace)",
            "returns": "Promise<PodInfo[]>",
            "params": [
              { "name": "clusterName", "type": "string", "default": "minikube" },
              { "name": "namespace", "type": "string", "default": "default" }
            ],
            "description": "List pods in namespace"
          },
          {
            "name": "getNamespaces(clusterName)",
            "returns": "Promise<string[]>",
            "params": [
              { "name": "clusterName", "type": "string", "default": "minikube" }
            ],
            "description": "Get all available namespaces"
          }
        ]
      },
      {
        "category": "Pod Debugging",
        "methods": [
          {
            "name": "getPodLogs(podName, clusterName, namespace)",
            "returns": "Promise<string>",
            "params": [
              { "name": "podName", "type": "string" },
              { "name": "clusterName", "type": "string", "default": "minikube" },
              { "name": "namespace", "type": "string", "default": "default" }
            ],
            "description": "Get pod logs (last 100 lines)"
          },
          {
            "name": "execInPod(podName, command, clusterName, namespace)",
            "returns": "Promise<string>",
            "params": [
              { "name": "podName", "type": "string" },
              { "name": "command", "type": "string[]" },
              { "name": "clusterName", "type": "string", "default": "minikube" },
              { "name": "namespace", "type": "string", "default": "default" }
            ],
            "description": "Execute command in pod"
          },
          {
            "name": "testPod(podName, clusterName, namespace)",
            "returns": "Promise<{ name, status, readiness, logs }>",
            "params": [
              { "name": "podName", "type": "string" },
              { "name": "clusterName", "type": "string", "default": "minikube" },
              { "name": "namespace", "type": "string", "default": "default" }
            ],
            "description": "Test pod connectivity and status"
          }
        ]
      }
    ],
    "types": {
      "MinikubeStatus": ["running", "stopped", "paused", "not-installed"],
      "MinikubeCluster": {
        "name": "string",
        "status": "MinikubeStatus",
        "driver": "string (optional)",
        "kubernetesVersion": "string (optional)",
        "ip": "string (optional)",
        "cpus": "number (optional)",
        "memory": "string (optional)"
      },
      "DeploymentInfo": {
        "name": "string",
        "namespace": "string",
        "replicas": "number",
        "readyReplicas": "number",
        "updatedReplicas": "number",
        "availableReplicas": "number",
        "age": "string"
      },
      "PodInfo": {
        "name": "string",
        "namespace": "string",
        "status": "string",
        "ready": "string",
        "restarts": "number",
        "age": "string"
      }
    }
  },

  "frontend": {
    "framework": "React",
    "language": "TypeScript",
    "stateManagement": "React Query",
    "styling": "CSS3",
    "hooks": [
      {
        "name": "useMinikubeHealth",
        "returns": "UseQueryResult<{ installed: boolean }>",
        "refetchInterval": 30000,
        "description": "Check if Minikube is installed",
        "queryKey": ["minikube", "health"]
      },
      {
        "name": "useMinikubeStatus",
        "params": [
          { "name": "clusterName", "type": "string", "default": "minikube" }
        ],
        "returns": "UseQueryResult<MinikubeCluster>",
        "refetchInterval": 10000,
        "description": "Get cluster status",
        "queryKey": ["minikube", "status", "clusterName"]
      },
      {
        "name": "useStartCluster",
        "returns": "UseMutationResult",
        "description": "Mutation to start cluster",
        "invalidates": ["minikube", "status"]
      },
      {
        "name": "useStopCluster",
        "returns": "UseMutationResult",
        "description": "Mutation to stop cluster",
        "invalidates": ["minikube", "status"]
      },
      {
        "name": "useDeleteCluster",
        "returns": "UseMutationResult",
        "description": "Mutation to delete cluster",
        "invalidates": ["minikube"]
      },
      {
        "name": "useDeployManifest",
        "returns": "UseMutationResult",
        "description": "Mutation to deploy manifest",
        "invalidates": ["minikube", "deployments"]
      },
      {
        "name": "useDeployments",
        "params": [
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "returns": "UseQueryResult<{ deployments: DeploymentInfo[] }>",
        "refetchInterval": 15000,
        "description": "List deployments",
        "queryKey": ["minikube", "deployments", "clusterName", "namespace"]
      },
      {
        "name": "usePods",
        "params": [
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "returns": "UseQueryResult<{ pods: PodInfo[] }>",
        "refetchInterval": 15000,
        "description": "List pods",
        "queryKey": ["minikube", "pods", "clusterName", "namespace"]
      },
      {
        "name": "usePodLogs",
        "params": [
          { "name": "podName", "type": "string" },
          { "name": "clusterName", "type": "string", "default": "minikube" },
          { "name": "namespace", "type": "string", "default": "default" }
        ],
        "returns": "UseQueryResult<{ logs: string }>",
        "description": "Get pod logs",
        "queryKey": ["minikube", "pod-logs", "podName", "clusterName", "namespace"],
        "enabled": "!!podName"
      },
      {
        "name": "useTestPod",
        "returns": "UseMutationResult",
        "description": "Mutation to test pod connectivity"
      },
      {
        "name": "useNamespaces",
        "params": [
          { "name": "clusterName", "type": "string", "default": "minikube" }
        ],
        "returns": "UseQueryResult<{ namespaces: string[] }>",
        "refetchInterval": 30000,
        "description": "List namespaces",
        "queryKey": ["minikube", "namespaces", "clusterName"]
      }
    ],
    "component": {
      "name": "MinikubePanel",
      "type": "React.FC",
      "sections": [
        {
          "name": "Header",
          "description": "Title and installation status badge"
        },
        {
          "name": "Cluster Status",
          "description": "Display current cluster state, IP, K8s version"
        },
        {
          "name": "Cluster Control",
          "description": "Start/Stop/Delete buttons with configuration form"
        },
        {
          "name": "Namespace Selection",
          "description": "Dropdown to select active namespace"
        },
        {
          "name": "Deployments Table",
          "description": "View all deployments in namespace"
        },
        {
          "name": "Pods Table",
          "description": "View all pods with status and test button"
        },
        {
          "name": "Pod Logs Viewer",
          "description": "Expandable logs section for selected pod"
        },
        {
          "name": "Manifest Deployment",
          "description": "Form to deploy custom YAML manifests"
        }
      ],
      "styling": {
        "approach": "CSS3 with CSS variables",
        "responsive": true,
        "mobileOptimized": true,
        "darkModeSupport": "via CSS variables"
      }
    }
  },

